# Public site origin (no trailing slash). Used for OG, sitemap, canonicals.
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# Optional PageSpeed Insights API key — fallback when Chrome is missing + CrUX field enrichment.
PAGESPEED_API_KEY=

# Days before on-disk reports / crawls / raw LHR in data/ are deleted (0 = never).
REPORT_TTL_DAYS=14

# Max concurrent lab jobs waiting/running on this process (default 8).
SWEEP_MAX_QUEUE=8

# Analyze / crawl rate limit per client IP (TanStack Pacer sliding window, process-local).
SWEEP_RATE_LIMIT=8
SWEEP_RATE_WINDOW_MS=60000

# Allow measuring localhost / private IPs (default: on in development, off in production).
# SWEEP_ALLOW_PRIVATE_URLS=1

# Homepage demo buttons (default: on in development, off in production).
# SWEEP_ALLOW_DEMO=1

# Chromium / Chrome binary when auto-detect fails (Docker sets this).
# CHROME_PATH=/usr/bin/chromium

# Listen port for `next start` (Docker uses 3000).
# PORT=3000
